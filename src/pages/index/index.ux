    line-height: 46px;
    background-color: #ff9500;
    border-radius: 5px;
    color: #000000;
    font-size: 15px;
    font-weight: bold;
    margin: 0 2px;
  }

  .grid-sym {
    width: 302px;
    flex-direction: column;
  }
  .sym-box {
    width: 302px;
    height: 160px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
  }
  .key-sym {
    width: 44px;
    height: 36px;
    text-align: center;
    line-height: 36px;
    background-color: #27272a;
    border-radius: 5px;
    color: #ffffff;
    font-size: 17px;
    margin-bottom: 4px;
  }
</style>

<script>
  import vibrator from '@system.vibrator';
  import storage from '@system.storage';
  import { matchPinyinSyllables, getCandidateChars, T9_KEYS } from '../../common/js/pinyin-dict.js';

  const STORAGE_KEY = 'band_notes_cache';

  export default {
    private: {
      viewMode: 'list',
      notes: [],
      curIndex: -1,
      currentText: '',
      cursorPos: 0,
      displayText: '',

      showKeyboard: false,
      isCandExpanded: false, // 是否全屏展开候选字
      expandPage: 0,
      expandPageSize: 16,
      expandTotalPages: 1,
      expandPageChars: [],
      kbMode: 'pinyin',

      inputCode: '',
      matchedSyllables: [],
      selectedSyllable: '',
      sylIndex: 0,
      allCand: [],
      visibleCand: [],
      pageIdx: 0,
      pageSize: 4,
      hasPrev: false,
      hasNext: false,

      isUpper: false,
      row1: ['q', 'w', 'e', 'r', 't', 'y', 'u', 'i', 'o', 'p'],
      row2: ['a', 's', 'd', 'f', 'g', 'h', 'j', 'k', 'l'],
      row3: ['z', 'x', 'c', 'v', 'b', 'n', 'm'],

      syms: ['，', '。', '！', '？', '：', '；', '“', '”', '、', '+', '-', '*', '/', '=', '1', '2', '3', '4', '5', '6', '7', '8', '9', '0']
    },

    onInit() {
      this.loadStorage();
    },

    onShow() {
      this.loadStorage();
    },

    onHide() {
      this.saveStorage();
    },

    onDestroy() {
      this.saveStorage();
    },

    onBackPress() {
      if (this.isCandExpanded) {
        this.isCandExpanded = false;
        return true; // 拦截返回，仅收起全屏候选字
      }
      if (this.showKeyboard) {
        this.showKeyboard = false;
        this.clearCode();
        return true; // 拦截返回，仅收起键盘
      }
      if (this.viewMode === 'edit') {
        this.backToList();
        return true; // 拦截返回，回到便签列表
      }
      return false; // 放行退出应用
    },

    vib() {
      try {
        vibrator.vibrate({ mode: 'short' });
      } catch (e) {}
    },

    loadStorage() {
      const that = this;
      try {
        storage.get({
          key: STORAGE_KEY,
          default: '[]',
          success: function(val) {
            try {
              const arr = JSON.parse(val);
              if (Array.isArray(arr) && arr.length > 0) {
                that.notes = arr;
              }
            } catch (e) {}
          }
        });
      } catch (e) {}
    },

    saveStorage() {
      if (this.curIndex >= 0 && this.notes[this.curIndex]) {
        this.notes[this.curIndex].content = this.currentText;
        this.notes[this.curIndex].time = this.nowStr();
      }
      try {
        storage.set({
          key: STORAGE_KEY,
          value: JSON.stringify(this.notes)
        });
      } catch (e) {}
    },

    nowStr() {
      const d = new Date();
      const m = d.getMonth() + 1;
      const day = d.getDate();
      const hh = d.getHours();
      const mm = d.getMinutes();
      return m + '/' + day + ' ' + (hh < 10 ? '0' + hh : hh) + ':' + (mm < 10 ? '0' + mm : mm);
    },

    updateDisplayText() {
      const len = this.currentText.length;
      if (this.cursorPos < 0) this.cursorPos = 0;
      if (this.cursorPos > len) this.cursorPos = len;
      this.displayText = this.currentText.slice(0, this.cursorPos) + '_' + this.currentText.slice(this.cursorPos);
    },

    cursorLeft() {
      this.vib();
      if (this.cursorPos > 0) {
        this.cursorPos--;
        this.updateDisplayText();
      }
    },

    cursorRight() {
      this.vib();
      if (this.cursorPos < this.currentText.length) {
        this.cursorPos++;
        this.updateDisplayText();
      }
    },

    cursorHome() {
      this.vib();
      this.cursorPos = 0;
      this.updateDisplayText();
    },

    cursorEnd() {
      this.vib();
      this.cursorPos = this.currentText.length;
      this.updateDisplayText();
    },

    newNote() {
      this.vib();
      const item = { content: '', time: this.nowStr() };
      this.notes.unshift(item);
      this.curIndex = 0;
      this.currentText = '';
      this.cursorPos = 0;
      this.updateDisplayText();
      this.viewMode = 'edit';
      this.showKeyboard = true;
      this.isCandExpanded = false;
      this.clearCode();
      this.saveStorage();
    },

    openNote(idx) {
      this.vib();
      this.curIndex = idx;
      this.currentText = (this.notes[idx] && this.notes[idx].content) || '';
      this.cursorPos = this.currentText.length;
      this.updateDisplayText();
      this.viewMode = 'edit';
      this.showKeyboard = false;
      this.isCandExpanded = false;
      this.clearCode();
    },

    deleteNote(idx) {
      this.vib();
      this.notes.splice(idx, 1);
      this.saveStorage();
    },

    backToList() {
      this.vib();
      this.saveStorage();
      this.viewMode = 'list';
      this.showKeyboard = false;
      this.isCandExpanded = false;
      this.clearCode();
    },

    toggleKb() {
      this.vib();
      this.showKeyboard = !this.showKeyboard;
      if (!this.showKeyboard) {
        this.isCandExpanded = false;
        this.clearCode();
      }
    },

    openExpandCand() {
      this.vib();
      if (this.allCand.length > 0) {
        this.expandPage = 0;
        this.updateExpandPage();
        this.isCandExpanded = true;
      }
    },

    closeExpandCand() {
      this.vib();
      this.isCandExpanded = false;
    },

    updateExpandPage() {
      this.expandTotalPages = Math.max(1, Math.ceil(this.allCand.length / this.expandPageSize));
      if (this.expandPage >= this.expandTotalPages) {
        this.expandPage = this.expandTotalPages - 1;
      }
      if (this.expandPage < 0) {
        this.expandPage = 0;
      }
      const start = this.expandPage * this.expandPageSize;
      this.expandPageChars = this.allCand.slice(start, start + this.expandPageSize);
    },

    prevExpandPage() {
      this.vib();
      if (this.expandPage > 0) {
        this.expandPage--;
        this.updateExpandPage();
      }
    },

    nextExpandPage() {
      if ((this.expandPage + 1) < this.expandTotalPages) {
        this.vib();
        this.expandPage++;
        this.updateExpandPage();
      }
    },

    changeMode(m) {
      this.vib();
      this.kbMode = m;
      this.isCandExpanded = false;
      this.clearCode();
    },

    clearCode() {
      this.inputCode = '';
      this.matchedSyllables = [];
      this.selectedSyllable = '';
      this.sylIndex = 0;
      this.allCand = [];
      this.visibleCand = [];
      this.pageIdx = 0;
      this.hasPrev = false;
      this.hasNext = false;
    },

    refreshCand() {
      const start = this.pageIdx * this.pageSize;
      this.visibleCand = this.allCand.slice(start, start + this.pageSize);
      this.hasPrev = this.pageIdx > 0;
      this.hasNext = (this.pageIdx + 1) * this.pageSize < this.allCand.length;
    },

    tapT9(key) {
      this.vib();
      if (this.kbMode === 'pinyin') {
        if (key === '1') {
          this.allCand = ['，', '。', '！', '？', '1'];
          this.inputCode = '1';
          this.matchedSyllables = [];
          this.selectedSyllable = '';
          this.sylIndex = 0;
          this.pageIdx = 0;
          this.refreshCand();
          return;
        }
        this.inputCode += key;
        this.matchedSyllables = matchPinyinSyllables(this.inputCode);
        this.selectedSyllable = '';
        this.sylIndex = 0;
        this.allCand = getCandidateChars(this.inputCode, '');
        this.pageIdx = 0;
        this.refreshCand();
      } else if (this.kbMode === 'en_t9') {
        this.inputCode = key;
        this.matchedSyllables = [];
        this.selectedSyllable = '';
        this.sylIndex = 0;
        this.allCand = T9_KEYS[key] || [key];
        this.pageIdx = 0;
        this.refreshCand();
      }
    },

    chooseSyllable(syl) {
      this.vib();
      this.selectedSyllable = syl;
      if (syl === '') {
        this.sylIndex = 0;
      } else {
        const idx = this.matchedSyllables.indexOf(syl);
        this.sylIndex = idx >= 0 ? idx + 1 : 0;
      }
      this.allCand = getCandidateChars(this.inputCode, syl);
      this.pageIdx = 0;
      this.refreshCand();
    },

    tapNavRight() {
      this.vib();
      if (this.inputCode === '') {
        this.cursorRight();
        return;
      }

      if (this.matchedSyllables.length > 0) {
        const total = this.matchedSyllables.length + 1;
        if (this.sylIndex < total - 1) {
          this.sylIndex++;
          const nextSyl = this.matchedSyllables[this.sylIndex - 1];
          this.selectedSyllable = nextSyl;
          this.allCand = getCandidateChars(this.inputCode, nextSyl);
          this.pageIdx = 0;
          this.refreshCand();
          return;
        } else {
          if (this.hasNext) {
            this.pageIdx++;
            this.refreshCand();
            return;
          }
        }
      } else {
        if (this.hasNext) {
          this.pageIdx++;
          this.refreshCand();
        }
      }
    },

    tapNavLeft() {
      this.vib();
      if (this.inputCode === '') {
        this.cursorLeft();
        return;
      }

      if (this.pageIdx > 0) {
        this.pageIdx--;
        this.refreshCand();
        return;
      }

      if (this.matchedSyllables.length > 0 && this.sylIndex > 0) {
        this.sylIndex--;
        if (this.sylIndex === 0) {
          this.selectedSyllable = '';
          this.allCand = getCandidateChars(this.inputCode, '');
        } else {
          const prevSyl = this.matchedSyllables[this.sylIndex - 1];
          this.selectedSyllable = prevSyl;
          this.allCand = getCandidateChars(this.inputCode, prevSyl);
        }
        this.pageIdx = 0;
        this.refreshCand();
      }
    },

    // 选中汉字上屏（无论在普通栏还是在全屏面板中，选字后自动关闭全屏面板并存盘）
    selectChar(c) {
      this.vib();
      const before = this.currentText.slice(0, this.cursorPos);
      const after = this.currentText.slice(this.cursorPos);
      this.currentText = before + c + after;
      this.cursorPos += c.length;
      this.updateDisplayText();
      this.isCandExpanded = false;
      this.clearCode();
      this.saveStorage();
    },

    prevCand() {
      this.vib();
      if (this.hasPrev) {
        this.pageIdx--;
        this.refreshCand();
      }
    },

    nextCand() {
      this.vib();
      if (this.hasNext) {
        this.pageIdx++;
        this.refreshCand();
      }
    },

    tapDel() {
      this.vib();
      if (this.inputCode.length > 0) {
        this.inputCode = this.inputCode.slice(0, -1);
        if (this.inputCode === '') {
          this.isCandExpanded = false;
          this.clearCode();
        } else {
          this.matchedSyllables = matchPinyinSyllables(this.inputCode);
          this.selectedSyllable = '';
          this.sylIndex = 0;
          this.allCand = getCandidateChars(this.inputCode, '');
          this.pageIdx = 0;
          this.refreshCand();
        }
      } else {
        if (this.cursorPos > 0) {
          let delLen = 1;
          if (this.cursorPos >= 2) {
            const code = this.currentText.charCodeAt(this.cursorPos - 1);
            const prevCode = this.currentText.charCodeAt(this.cursorPos - 2);
            if (code >= 0xDC00 && code <= 0xDFFF && prevCode >= 0xD800 && prevCode <= 0xDBFF) {
              delLen = 2;
            }
          }
          const before = this.currentText.slice(0, this.cursorPos - delLen);
          const after = this.currentText.slice(this.cursorPos);
          this.currentText = before + after;
          this.cursorPos -= delLen;
          this.updateDisplayText();
          this.saveStorage();
        }
      }
    },

    tapSpace() {
      this.vib();
      if (this.visibleCand.length > 0) {
        this.selectChar(this.visibleCand[0]);
      } else {
        const before = this.currentText.slice(0, this.cursorPos);
        const after = this.currentText.slice(this.cursorPos);
        this.currentText = before + ' ' + after;
        this.cursorPos += 1;
        this.updateDisplayText();
        this.saveStorage();
      }
    },

    tapClear() {
      this.vib();
      this.isCandExpanded = false;
      if (this.inputCode !== '') {
        this.clearCode();
      } else {
        const before = this.currentText.slice(0, this.cursorPos);
        const after = this.currentText.slice(this.cursorPos);
        this.currentText = before + '0' + after;
        this.cursorPos += 1;
        this.updateDisplayText();
        this.saveStorage();
      }
    },

    tap26(c) {
      this.vib();
      const char = this.isUpper ? c.toUpperCase() : c.toLowerCase();
      const before = this.currentText.slice(0, this.cursorPos);
      const after = this.currentText.slice(this.cursorPos);
      this.currentText = before + char + after;
      this.cursorPos += char.length;
      this.updateDisplayText();
      this.saveStorage();
    },

    toggleShift() {
      this.vib();
      this.isUpper = !this.isUpper;
    },

    tapEnter() {
      this.vib();
      const before = this.currentText.slice(0, this.cursorPos);
      const after = this.currentText.slice(this.cursorPos);
      this.currentText = before + '\n' + after;
      this.cursorPos += 1;
      this.updateDisplayText();
      this.saveStorage();
    },

    tapSym(s) {
      this.vib();
      const before = this.currentText.slice(0, this.cursorPos);
      const after = this.currentText.slice(this.cursorPos);
      this.currentText = before + s + after;
      this.cursorPos += s.length;
      this.updateDisplayText();
      this.saveStorage();
    }
  };
</script>
