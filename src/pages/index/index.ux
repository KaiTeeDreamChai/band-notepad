<template>
  <div class="root">
    <!-- 1. 全屏候选字展示面板 (点击展开按钮时覆盖全屏) -->
    <!-- 1. 全屏候选字展示面板 (带分页控制，可翻看所有候选字) -->
    <div if="{{isCandExpanded}}" class="expand-cand-view">
      <div class="expand-header">
        <text class="expand-title">【{{selectedSyllable ? selectedSyllable : '全部'}}】{{expandPage + 1}}/{{expandTotalPages}} ({{allCand.length}}字)</text>
        <div class="expand-close-btn" onclick="closeExpandCand">
          <text class="expand-close-txt">✕ 收起</text>
        </div>
      </div>
      <!-- 4列全屏大字网格 (每页16字，4行4列大字按键) -->
      <div class="expand-grid">
        <div for="{{expandPageChars}}" class="expand-cell" onclick="selectChar($item)">
          <text class="expand-word">{{$item}}</text>
        </div>
      </div>
      <!-- 底部翻页控制器 -->
      <div class="expand-footer">
        <div class="{{expandPage > 0 ? 'expand-page-btn' : 'expand-page-btn-disabled'}}" onclick="prevExpandPage">
          <text class="expand-page-txt">‹ 上一页</text>
        </div>
        <text class="expand-page-info">{{expandPage + 1}} / {{expandTotalPages}}</text>
        <div class="{{(expandPage + 1) < expandTotalPages ? 'expand-page-btn' : 'expand-page-btn-disabled'}}" onclick="nextExpandPage">
          <text class="expand-page-txt">下一页 ›</text>
        </div>
      </div>
    </div>

    <!-- 2. 便签列表视图 -->
    <div if="{{!isCandExpanded && viewMode === 'list'}}" class="view-box">
      <div class="top-bar">
        <text class="top-title">腕上记事本</text>
        <text class="top-sub">{{notes.length}}条</text>
      </div>

      <div class="list-container">
        <div if="{{notes.length === 0}}" class="empty-state">
          <text class="empty-text">暂无便签，点击下方新建</text>
        </div>

        <div for="{{notes}}" class="item-card" onclick="openNote($idx)">
          <div class="item-left">
            <text class="item-title">{{$item.content ? $item.content : '空白便签'}}</text>
            <text class="item-time">{{$item.time}}</text>
          </div>
          <div class="item-del" onclick="deleteNote($idx)">
            <text class="del-txt">删</text>
          </div>
        </div>
      </div>

      <div class="add-btn-wrap">
        <div class="add-btn" onclick="newNote">
          <text class="add-btn-txt">＋ 新建便签</text>
        </div>
      </div>
    </div>

    <!-- 3. 便签编辑 / 打字视图 -->
    <div if="{{!isCandExpanded && viewMode === 'edit'}}" class="view-box">
      <div class="top-bar">
        <div class="back-btn" onclick="backToList">
          <text class="btn-txt">〈 存盘返回</text>
        </div>
        <text class="top-sub">{{cursorPos}}/{{currentText.length}}字</text>
      </div>

      <!-- 文本区域：单击唤起/收起键盘 -->
      <div class="{{showKeyboard ? 'text-box-short' : 'text-box-browse'}}" onclick="toggleKb">
        <text class="editor-txt">{{displayText}}</text>
        <text if="{{currentText === '' && !showKeyboard}}" class="tip-txt">轻触此处或下方打字按钮编辑...</text>
      </div>

      <!-- 浏览文本模式下的光标与编辑控制栏 (仅在键盘收起时显示) -->
      <div if="{{!showKeyboard}}" class="browse-ctrl-bar">
        <div class="b-ctrl-btn" onclick="cursorHome"><text class="b-ctrl-txt">|‹</text></div>
        <div class="b-ctrl-btn" onclick="cursorLeft"><text class="b-ctrl-txt">‹</text></div>
        <div class="b-ctrl-btn" onclick="cursorRight"><text class="b-ctrl-txt">›</text></div>
        <div class="b-ctrl-btn" onclick="cursorEnd"><text class="b-ctrl-txt">›|</text></div>
        <div class="b-ctrl-del" onclick="tapDel"><text class="b-ctrl-txt-del">⌫</text></div>
        <div class="b-ctrl-kb" onclick="toggleKb"><text class="b-ctrl-txt-kb">⌨ 打字</text></div>
      </div>

      <!-- 虚拟键盘 (IME) -->
      <div if="{{showKeyboard}}" class="kb-wrap">
        <!-- 预选拼音音节栏 -->
        <div if="{{kbMode === 'pinyin' && inputCode !== '' && matchedSyllables.length > 0}}" class="syl-bar">
          <text class="{{selectedSyllable === '' ? 'syl-pill-active' : 'syl-pill'}}" onclick="chooseSyllable('')">全部</text>
          <text for="{{matchedSyllables}}" class="{{selectedSyllable === $item ? 'syl-pill-active' : 'syl-pill'}}" onclick="chooseSyllable($item)">{{$item}}</text>
        </div>

        <!-- 候选字栏 (25px 大字号 + 全屏展开按钮) -->
        <div class="cand-bar">
          <div class="cand-list">
            <text for="{{visibleCand}}" class="cand-word" onclick="selectChar($item)">{{$item}}</text>
            <text if="{{visibleCand.length === 0 && inputCode === ''}}" class="cand-tip">轻触下方按键打字</text>
          </div>
          <!-- 翻页控制与全屏展开按钮 -->
          <div class="cand-actions">
            <text if="{{hasPrev}}" class="arrow-btn" onclick="prevCand">‹</text>
            <text if="{{hasNext}}" class="arrow-btn" onclick="nextCand">›</text>
            <div if="{{allCand.length > 0}}" class="expand-btn" onclick="openExpandCand">
              <text class="expand-icon">⤢</text>
            </div>
          </div>
        </div>

        <!-- 键盘模式切换栏 -->
        <div class="mode-bar">
          <text class="{{kbMode === 'pinyin' ? 'mode-txt-active' : 'mode-txt'}}" onclick="changeMode('pinyin')">拼音9</text>
          <text class="{{kbMode === 'en_t9' ? 'mode-txt-active' : 'mode-txt'}}" onclick="changeMode('en_t9')">英文9</text>
          <text class="{{kbMode === 'en_26' ? 'mode-txt-active' : 'mode-txt'}}" onclick="changeMode('en_26')">英文26</text>
          <text class="{{kbMode === 'sym' ? 'mode-txt-active' : 'mode-txt'}}" onclick="changeMode('sym')">符号</text>
        </div>

        <!-- 键盘核心区 -->
        <div class="keys-wrap">
          <!-- 1. 九键模式 (拼音或英文9) -->
          <div if="{{kbMode === 'pinyin' || kbMode === 'en_t9'}}" class="grid-t9">
            <div class="row-t9">
              <div class="key-t9" onclick="tapT9('1')"><text class="t9-m">1</text><text class="t9-s">，。！</text></div>
              <div class="key-t9" onclick="tapT9('2')"><text class="t9-m">2</text><text class="t9-s">abc</text></div>
              <div class="key-t9" onclick="tapT9('3')"><text class="t9-m">3</text><text class="t9-s">def</text></div>
            </div>
            <div class="row-t9">
              <div class="key-t9" onclick="tapT9('4')"><text class="t9-m">4</text><text class="t9-s">ghi</text></div>
              <div class="key-t9" onclick="tapT9('5')"><text class="t9-m">5</text><text class="t9-s">jkl</text></div>
              <div class="key-t9" onclick="tapT9('6')"><text class="t9-m">6</text><text class="t9-s">mno</text></div>
            </div>
            <div class="row-t9">
              <div class="key-t9" onclick="tapT9('7')"><text class="t9-m">7</text><text class="t9-s">pqrs</text></div>
              <div class="key-t9" onclick="tapT9('8')"><text class="t9-m">8</text><text class="t9-s">tuv</text></div>
              <div class="key-t9" onclick="tapT9('9')"><text class="t9-m">9</text><text class="t9-s">wxyz</text></div>
            </div>
            <!-- 底栏：重输、左移、空格确认、右移、退格 -->
            <div class="row-t9">
              <div class="key-f-btn" onclick="tapClear"><text class="f-txt">{{inputCode !== '' ? '重输' : '0'}}</text></div>
              <div class="key-f-btn" onclick="tapNavLeft"><text class="f-txt">‹</text></div>
              <div class="key-f-space" onclick="tapSpace"><text class="f-txt">空格</text></div>
              <div class="key-f-btn" onclick="tapNavRight"><text class="f-txt">›</text></div>
              <div class="key-f-btn" onclick="tapDel"><text class="f-txt">⌫</text></div>
            </div>
          </div>

          <!-- 2. 英文 26 键 -->
          <div if="{{kbMode === 'en_26'}}" class="grid-26">
            <div class="row-26">
              <text for="{{row1}}" class="key-26" onclick="tap26($item)">{{isUpper ? $item.toUpperCase() : $item}}</text>
            </div>
            <div class="row-26">
              <text for="{{row2}}" class="key-26" onclick="tap26($item)">{{isUpper ? $item.toUpperCase() : $item}}</text>
            </div>
            <div class="row-26">
              <text class="{{isUpper ? 'key-f-26-active' : 'key-f-26'}}" onclick="toggleShift">⇧</text>
              <text for="{{row3}}" class="key-26" onclick="tap26($item)">{{isUpper ? $item.toUpperCase() : $item}}</text>
              <text class="key-f-26" onclick="tapDel">⌫</text>
            </div>
            <div class="row-26">
              <text class="key-nav-26" onclick="cursorLeft">‹</text>
              <text class="key-space-26" onclick="tapSpace">Space</text>
              <text class="key-enter-26" onclick="tapEnter">↵</text>
              <text class="key-nav-26" onclick="cursorRight">›</text>
            </div>
          </div>

          <!-- 3. 符号面板 -->
          <div if="{{kbMode === 'sym'}}" class="grid-sym">
            <div class="sym-box">
              <text for="{{syms}}" class="key-sym" onclick="tapSym($item)">{{$item}}</text>
            </div>
            <div class="row-t9" style="margin-top: 6px;">
              <div class="key-f-space" style="width: 180px;" onclick="tapSpace"><text class="f-txt">空格</text></div>
              <div class="key-f-btn" style="width: 110px;" onclick="tapDel"><text class="f-txt">⌫ 退格</text></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

